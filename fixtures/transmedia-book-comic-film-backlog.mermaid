        BOOK_07(["BOOK-07: Cover Art, Typography & Book Typesetting"])
        BOOK_08(["BOOK-08: Worldwide Book Release & Audiobook Production"])
    end
    subgraph 01_ip_legal_rights["01-ip-legal-rights"]
        LEGAL_01(["LEGAL-01: IP Copyright Registration & Global Trademark Protection"])
        LEGAL_02(["LEGAL-02: Comic Book Adaptation Rights & Publishing Contract"])
        LEGAL_03(["LEGAL-03: Hollywood Studio Film Option & Purchase Agreement"])
        LEGAL_04["LEGAL-04: Guild Clearances (SAG-AFTRA, DGA, WGA Compliance)"]
    end
    subgraph 02_comic_adaptation["02-comic-adaptation"]
        COMIC_01(["COMIC-01: Comic Script & Panel-by-Panel Breakdown (Vol 1-4)"])
        COMIC_02(["COMIC-02: Character Model Sheets, Costumes & Creature Design"])
        COMIC_03(["COMIC-03: Rough Thumbnails & Pencils (Volumes 1-4, 180 Pages)"])
        COMIC_04["COMIC-04: Inking & Final Line Art (180 Pages)"]
        COMIC_05["COMIC-05: Digital Coloring, Lighting & Ambient Atmosphere"]
        COMIC_06["COMIC-06: Lettering, Sound Effects (SFX) & Balloon Placement"]
        COMIC_07["COMIC-07: Deluxe Hardcover Print Run & Comic-Con Launch"]
    end
    subgraph 03_film_preproduction["03-film-preproduction"]
        FILM_01(["FILM-01: Hollywood Feature Screenplay (Draft 1 & Studio Polish)"])
        FILM_02(["FILM-02: Director Lookbook & Cinematic Concept Art"])
        FILM_03(["FILM-03: $150M Production Financing & Studio Greenlight"])
        FILM_04["FILM-04: Principal Casting (A-List Leads & Supporting Cast)"]
        FILM_05["FILM-05: Production Design, Physical Sets & Miniature Construction"]
        FILM_06["FILM-06: Location Scouting & International Filming Permits"]
        FILM_07["FILM-07: IMAX 70mm Camera Package & Custom Anamorphic Lenses"]
    end
    subgraph 04_film_production["04-film-production"]
        PROD_01["PROD-01: Cast Table Read & Rehearsals"]
        PROD_02["PROD-02: Stunt Choreography, Wirework & Combat Training"]
        PROD_03["PROD-03: Principal Photography — Phase 1: Soundstages (60 Days)"]
        PROD_04["PROD-04: Principal Photography — Phase 2: On-Location Shoots (45 Days)"]
        PROD_05["PROD-05: Pickups, Second Unit & VFX Lighting Capture Wraps"]
    end
    subgraph 05_film_postproduction["05-film-postproduction"]
        POST_01["POST-01: Assembly Cut & Director's Rough Edit"]
        POST_02["POST-02: Visual Effects (VFX) Pipeline (ILM / Wētā FX, 1,400 Shots)"]
        POST_03["POST-03: Orchestral Score Composition & Abbey Road Studio Recording"]
        POST_04["POST-04: Foley, Sound Design & Dolby Atmos 7.1.4 Surround Mix"]
        POST_05["POST-05: Color Grading (ACES HDR Pipeline) & Picture Lock"]
        POST_06["POST-06: Final Theatrical Master (IMAX DMR & DCP Package)"]
    end
    subgraph 06_film_marketing_release["06-film-marketing-release"]
        MKT_01["MKT-01: Teaser Trailer Launch & Viral Alternate Reality Game (ARG)"]
        MKT_02["MKT-02: Official Main Theatrical Trailer & Soundtrack Single Debut"]
