flowchart TD
    subgraph 00_lore_novel_creation["00-lore-novel-creation"]
        BOOK_01(["BOOK-01: Worldbuilding Bible, Magic System & Historical Timeline"])
        BOOK_02(["BOOK-02: Character Arcs, Psychological Profiles & Dialogue Voices"])
