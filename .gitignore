# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Environments
.venv/
env/
venv/
ENV/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test coverage & caches
.pytest_cache/
.coverage
htmlcov/

# Local run outputs
output/
*.log
*.tmp

# Relay/audit/planning artifacts are operational evidence, not source.
.relay/

# Active operational graph instances
work-graph.json

# Local credentials and private working material (never publication inputs)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local.env
/.aws/
/.ssh/
/.secrets/
/.credentials/
/.private/
/.internal/
/.reconciliation/
credentials.local.*
id_rsa
id_ed25519
*.p12
*.pfx
.claude/settings.local.json
.aider*

# SQLite runtime sidecars can contain the same private data as the database
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

